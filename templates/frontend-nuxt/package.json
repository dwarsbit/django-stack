{
  "name": "{{project_name}}-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "nuxt typecheck",
    "test": "vitest run",
    "generate:types": "headless generate --url \"${API_URL:-http://localhost:8000/api}/schema\" --out src/lib/headless.ts"
  },
  "dependencies": {
    "@django-headless/client": "^1.1.1",
    "@django-stack/utils": "^0.3.0",
    "@django-stack/vue": "^0.3.0",
    "nuxt": "^4.6.3",
    "nuxt-security": "^2.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22"
  }
}
