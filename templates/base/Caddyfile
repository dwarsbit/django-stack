# {{project_name}}: the reverse proxy of the prod profile.
#
# @if frontend
# One domain: Django serves /admin, /api and /static; uploads on the server's
# disk are served from /media; Umami's tracker from /_a/; the frontend
# serves everything else. Caddy
# @end
# @if !frontend
# One domain: Django serves everything (the API, the admin, /static and a
# start page); uploads on the server's disk are served from /media. Caddy
# @end
# gets and renews the HTTPS certificate for SITE_URL by itself.
#
# Behind a platform's proxy (Coolify, Dokploy), CADDY_ADDRESS=:80 serves
# plain HTTP to that proxy, and TRUSTED_PROXIES=private_ranges keeps the
# client's address and scheme it forwards. See the deployment docs.

{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

{$CADDY_ADDRESS} {
	encode zstd gzip

	# Defaults for every response; Django and the frontend set their own,
	# stricter ones where they need them. One directive per header: Caddy
	# skips a whole block of `?` headers when any one of them is set.
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header ?X-Frame-Options "DENY"
	header -Server

	# A request ID for every request: Django and the frontend add it to
	# their log lines and return it in X-Request-ID, and Caddy's own log
	# line carries it as request_id. One sent by the client is replaced.
	request_header X-Request-ID {http.request.uuid}
	log_append request_id {http.request.uuid}

	# Uploads, when media is stored on the server instead of S3. No scripts
	# run from uploaded files, whatever their type.
	handle_path /media/* {
		root * /srv/media
		header Content-Security-Policy "script-src 'none'; object-src 'none'"
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Page analytics: only Umami's tracker and its page views, never its
	# interface or API. Without the analytics profile these answer 502.
	handle_path /_a/* {
		@tracker path /script.js /api/send
		handle @tracker {
			reverse_proxy umami:3000
		}
		handle {
			respond 404
		}
	}

	# @if frontend
	@django path /admin /admin/* /api /api/* /static/*
	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
	# @end
	# @if !frontend
	# The health checks are for Docker and the platforms, not the public.
	@health path /healthz /readyz /statusz
	handle @health {
		respond 404
	}

	handle {
		reverse_proxy backend:8000
	}
	# @end

	log {
		output stdout
		format json
	}
}
