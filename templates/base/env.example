# {{project_name}} environment. `npx @django-stack/cli init` generates .env
# from this file with fresh secrets; .env.example keeps the names without
# values. Never commit .env.

PROJECT_NAME={{project_name}}

# Compose profiles: `db` runs the bundled Postgres. Remove it to use an
# external database through DATABASE_URL.
COMPOSE_PROFILES=db

# The public URL of the site. In development the frontend's dev server also
# serves /admin, /api and /media, so both URLs are the frontend's.
SITE_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Django
DJANGO_SECRET_KEY={{secret:django}}
DJANGO_DEBUG=1

# Database: the bundled Postgres, or your own URL for an external one.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD={{secret:postgres}}
DATABASE_URL=postgres://app:{{secret:postgres}}@db:5432/app

# Cache, task queue and mail
CACHE_URL=redis://cache:6379/0
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL={{project_name}} <noreply@localhost>

# Content API keys. The full-access key is for scripts only; the frontend
# gets the read-only key. They must differ.
API_SECRET_KEY={{secret:api}}
API_READ_KEY={{secret:api_read}}

# Shared between Django and the frontend: preview links and revalidation.
PREVIEW_SECRET={{secret:preview}}
REVALIDATE_SECRET={{secret:revalidate}}
REVALIDATE_URL=http://frontend:3000/revalidate

# The first admin user, created on the first start.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD={{secret:admin}}

# Demo content for an empty site (pages, posts, menus); 0 to start empty.
SEED_DEMO_CONTENT=1
