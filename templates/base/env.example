# {{project_name}} environment. `npx @django-stack/cli init` generates .env
# from this file with fresh secrets; .env.example keeps the names without
# values. Never commit .env.

PROJECT_NAME={{project_name}}

# Which services run (see compose.yaml):
#   dev,db   development on this machine
#   prod,db  production on a server
# Leave out `db` when DATABASE_URL points to an external Postgres; add `s3`
# in development for the local S3 service. `analytics` runs Umami, `valkey`
# the Valkey service.
COMPOSE_PROFILES=dev,db

# The public URL of the site. In development the frontend's dev server also
# serves /admin, /api and /media, so both URLs are the frontend's. In
# production set both to https://your-domain: Caddy gets the certificate.
SITE_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# The ports of the development services on this machine: the site with the
# admin, the backend, Mailpit and the local S3 service. `init` and
# `dstack dev` move to free ones when these are in use, and change the
# URLs above with SITE_PORT.
SITE_PORT=3000
BACKEND_PORT=8000
MAIL_PORT=8025
S3_PORT=8333

# Behind the proxy of a platform such as Coolify or Dokploy, which gets the
# certificate, Caddy serves plain HTTP on port 80 to it instead:
#   CADDY_ADDRESS=:80 TRUSTED_PROXIES=private_ranges NUM_PROXIES=2
#   HTTP_PORT=127.0.0.1:8080 HTTPS_PORT=127.0.0.1:8443

# Django. The prod profile always runs with debug off.
DJANGO_SECRET_KEY={{secret:django}}
DJANGO_DEBUG=1

# Database: the bundled Postgres, or your own URL for an external one
# (add ?sslmode=require for a server on another host).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD={{secret:postgres}}
DATABASE_URL=postgres://app:{{secret:postgres}}@db:5432/app

# Cache and task queue: db:// keeps them in tables in the database, so
# nothing else runs. For the Valkey service add `valkey` to COMPOSE_PROFILES
# and use redis://cache:6379/0 (the cache) or redis://cache:6379/1 (the
# tasks). CACHE_URL=locmem:// is a cache per process. TASKS_URL=immediate://
# runs tasks in the request, with TASK_WORKERS=0 to stop the worker; there
# are no daily backups then.
CACHE_URL=db://
TASKS_URL=db://
TASK_WORKERS=1

# Mail. In production, EMAIL_URL is your SMTP server, such as
# smtp+tls://user:password@smtp.example.com:587.
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL={{project_name}} <noreply@localhost>

# Content API keys. The full-access key is for scripts only; the frontend
# gets the read-only key. They must differ.
API_SECRET_KEY={{secret:api}}
API_READ_KEY={{secret:api_read}}

# Shared between Django and the frontend: preview links and revalidation.
PREVIEW_SECRET={{secret:preview}}
REVALIDATE_SECRET={{secret:revalidate}}
REVALIDATE_URL=http://frontend:3000/revalidate

# The first admin user, created on the first start.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD={{secret:admin}}

# Demo content for an empty site (pages, posts, menus); 0 to start empty.
SEED_DEMO_CONTENT=1

# Media in S3 instead of on this server: any S3-compatible service (AWS,
# Cloudflare R2, Hetzner, Scaleway). Uploads must be publicly readable, at
# S3_PUBLIC_URL when that is not the endpoint (a CDN or a custom domain).
# For the local S3 service: add `s3` to COMPOSE_PROFILES and use
#   S3_BUCKET=media S3_ENDPOINT_URL=http://s3:8333
#   S3_PUBLIC_URL=http://localhost:8333/media S3_CREATE_BUCKET=1
#   S3_ACCESS_KEY_ID=local S3_SECRET_ACCESS_KEY=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Page analytics: Umami, in the `analytics` profile. It runs on the internal
# network only: its tracker and the page views pass through /_a/ on the
# site, and the admin shows the numbers under Analytics. Umami keeps its
# tables in the `umami` schema of the database (UMAMI_DATABASE_URL is
# DATABASE_URL with ?schema=umami), so backups include them. The backend
# replaces Umami's default admin password with UMAMI_ADMIN_PASSWORD and
# creates the website UMAMI_WEBSITE_ID on start. To turn analytics off,
# remove `analytics` from COMPOSE_PROFILES and empty UMAMI_URL.
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_ADMIN_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_DATABASE_URL=

# Backups (prod profile): a daily pg_dump at BACKUP_TIME (UTC) and, when
# uploads are on disk (no S3_BUCKET) and BACKUP_MEDIA=1, an archive of the
# media volume; the newest BACKUP_KEEP of each kept in the backups volume.
# Set BACKUP_S3_BUCKET to a private bucket (never the public media bucket)
# to keep a copy off the server; it uses the S3_* credentials unless
# BACKUP_S3_* ones are set.
BACKUP_TIME=03:00
BACKUP_KEEP=14
BACKUP_MEDIA=1
BACKUP_S3_BUCKET=
# Requested after each daily backup: the URL of a Healthchecks.io check or
# an Uptime Kuma push monitor, which alerts you when the pings stop.
BACKUP_PING_URL=

# Logs: one JSON object per line in production, plain text in development
# (LOG_FORMAT=json or plain). LOG_ACCESS=0 turns off Django's access log.
# See the logs page of the DjangoStack docs.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# LOG_ACCESS=1
