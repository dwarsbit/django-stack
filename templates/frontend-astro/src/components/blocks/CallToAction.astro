---
import type { CallToActionBlock } from "@django-stack/utils";

const { block } = Astro.props as { block: CallToActionBlock };
---

<aside class="cta">
  <h2>{block.value.title}</h2>
  {block.value.text && <p>{block.value.text}</p>}
  <a class="button" href={block.value.button_url}>{block.value.button_label}</a>
</aside>

<style>
  .cta {
    margin: 2.5rem 0;
    padding: 2rem;
    border-radius: 0.75rem;
    background: var(--color-accent-soft);
  }
  .cta h2 {
    margin-top: 0;
  }
</style>
