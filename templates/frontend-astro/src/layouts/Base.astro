---
import { linkHref, type SeoInput, safeHref } from "@django-stack/utils";
import Image from "../components/Image.astro";
import RichText from "../components/RichText.astro";
import Seo from "../components/Seo.astro";
import { getContent, PREVIEW_COOKIE } from "../lib/api";
import "../styles/global.css";

interface Props {
  page?: SeoInput | null;
  type?: "website" | "article";
}

const { page, type } = Astro.props;
const content = getContent(Astro.cookies);
const [settings, mainMenu, footerMenu] = await Promise.all([
  content.getSiteSettings(),
  content.getMenu("main"),
  content.getMenu("footer"),
]);
const preview = Astro.cookies.has(PREVIEW_COOKIE);
const path = Astro.url.pathname;
// Page analytics: Umami's tracker, served from this site at /_a/.
const analytics = process.env.UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={settings?.site_name ?? "RSS"} href="/rss.xml" />
    <Seo page={page} settings={settings} type={type} />
    {analytics && <script is:inline defer src="/_a/script.js" data-website-id={analytics} />}
  </head>
  <body>
    {
      preview && (
        <div class="preview-banner">
          Preview: drafts are shown. <a href="/preview/exit">Leave preview</a>
        </div>
      )
    }
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/">
          {settings?.logo ? <Image media={settings.logo} size="thumbnail" alt={settings.site_name} eager /> : settings?.site_name}
        </a>
        <nav aria-label="Main">
          {
            mainMenu?.items.map((item) => {
              const href = linkHref(item);
              const current = href === path || (href !== "/" && path.startsWith(`${href}/`));
              return (
                <a href={href} aria-current={current ? "page" : undefined}>
                  {item.value.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container bar muted">
        <RichText html={settings?.footer_text} class="footer-text" />
        <nav aria-label="Footer">
          {footerMenu?.items.map((item) => <a href={linkHref(item)}>{item.value.label}</a>)}
          {Object.entries(settings?.social_links ?? {}).map(([name, url]) => <a href={safeHref(String(url))} rel="me">{name}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.2rem;
    color: inherit;
    text-decoration: none;
  }
  .brand :global(img) {
    height: 2.5rem;
    width: auto;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  nav a {
    text-decoration: none;
  }
  nav a[aria-current="page"] {
    font-weight: 600;
    text-decoration: underline;
  }
  main {
    min-height: 70vh;
    padding-block: 2rem 4rem;
  }
  .site-footer {
    border-top: 1px solid var(--color-line);
    font-size: 0.9rem;
  }
  .site-footer :global(.footer-text p) {
    margin: 0;
  }
</style>
