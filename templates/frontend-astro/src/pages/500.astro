---
// The page for an error while a page renders. It calls no API, so it still
// shows when the backend or the database is the problem. Without it, Astro
// answers with an empty 500 that has no Content-Type, which some browsers
// offer as a download.
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Something went wrong</title>
  </head>
  <body>
    <main>
      <section class="narrow">
        <h1>Something went wrong</h1>
        <p>The page could not be shown. Try again in a moment.</p>
        <p><a href="/">Go to the home page</a></p>
      </section>
    </main>
  </body>
</html>

<style>
  main {
    min-height: 70vh;
    padding-block: 4rem;
  }
</style>
