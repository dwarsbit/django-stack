---
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";
import { getContent } from "../../lib/api";

const content = getContent(Astro.cookies);
const slug = Astro.params.slug ?? "";
const category = await content.getCategory(slug);

if (!category) {
  return Astro.rewrite("/404");
}

const page = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
const result = await content.getPosts({ category: slug, page, limit: 9 });
---

<Base page={{ title: category.name, seo_description: category.description ?? "" }}>
  <section class="container">
    <p class="muted">Category</p>
    <h1>{category.name}</h1>
    {category.description && <p>{category.description}</p>}
    <PostList result={result} base={`/category/${slug}`} />
  </section>
</Base>
