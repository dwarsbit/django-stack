{
  "name": "site",
  "networks": {
    "default": {
      "name": "site_default",
      "ipam": {}
    }
  },
  "services": {
    "backend-prod": {
      "profiles": [
        "prod"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "memory": "805306368"
          }
        },
        "placement": {}
      },
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "ADMIN_EMAIL": "admin@example.com",
        "ADMIN_PASSWORD": "test-admin-password",
        "ADMIN_USERNAME": "admin",
        "API_READ_KEY": "test-api-read-key",
        "API_SECRET_KEY": "test-api-secret-key",
        "BACKEND_URL": "https://example.com",
        "BACKUP_KEEP": "14",
        "BACKUP_MEDIA": "1",
        "BACKUP_S3_BUCKET": "",
        "BACKUP_TIME": "03:00",
        "CACHE_URL": "redis://cache:6379/0",
        "COMPOSE_PROFILES": "prod,db",
        "DATABASE_URL": "postgres://app:test-postgres-password@db:5432/app",
        "DEFAULT_FROM_EMAIL": "site <noreply@example.com>",
        "DJANGO_CHECK_DEPLOY": "1",
        "DJANGO_DEBUG": "0",
        "DJANGO_MIGRATE": "1",
        "DJANGO_SECRET_KEY": "test-django-secret-key",
        "EMAIL_URL": "smtp+tls://user:password@smtp.example.com:587",
        "NUM_PROXIES": "2",
        "POSTGRES_DB": "app",
        "POSTGRES_PASSWORD": "test-postgres-password",
        "POSTGRES_USER": "app",
        "PREVIEW_SECRET": "test-preview-secret",
        "PROJECT_NAME": "site",
        "REVALIDATE_SECRET": "test-revalidate-secret",
        "REVALIDATE_URL": "http://frontend:3000/revalidate",
        "S3_ACCESS_KEY_ID": "",
        "S3_BUCKET": "site-media",
        "S3_ENDPOINT_URL": "",
        "S3_PUBLIC_URL": "",
        "S3_REGION": "",
        "S3_SECRET_ACCESS_KEY": "",
        "SEED_DEMO_CONTENT": "1",
        "SITE_URL": "https://example.com"
      },
      "image": "site-backend",
      "networks": {
        "default": {
          "aliases": [
            "backend"
          ]
        }
      },
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "media",
          "target": "/app/media",
          "volume": {}
        }
      ],
      "build": {
        "context": "/project/backend",
        "dockerfile": "Dockerfile",
        "target": "prod"
      },
      "depends_on": {
        "cache": {
          "condition": "service_healthy",
          "required": true
        },
        "db": {
          "condition": "service_healthy",
          "required": false
        },
        "s3": {
          "condition": "service_started",
          "required": false
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:8000/readyz', timeout=4)"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 30,
        "start_period": "1m0s"
      }
    },
    "cache": {
      "deploy": {
        "resources": {
          "limits": {
            "memory": "268435456"
          }
        },
        "placement": {}
      },
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "valkey-server",
        "--save",
        "",
        "--appendonly",
        "no",
        "--maxmemory",
        "200mb",
        "--maxmemory-policy",
        "volatile-lru"
      ],
      "entrypoint": null,
      "image": "valkey/valkey:8-alpine",
      "networks": {
        "default": null
      },
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "user": "valkey",
      "healthcheck": {
        "test": [
          "CMD",
          "valkey-cli",
          "ping"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 20
      }
    },
    "db": {
      "profiles": [
        "db"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "memory": "1073741824"
          }
        },
        "placement": {}
      },
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "app",
        "POSTGRES_PASSWORD": "test-postgres-password",
        "POSTGRES_USER": "app"
      },
      "image": "postgres:17-alpine",
      "networks": {
        "default": null
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"
        ],
        "timeout": "3s",
        "interval": "3s",
        "retries": 20
      }
    },
    "frontend-prod": {
      "profiles": [
        "prod"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "API_READ_KEY": "test-api-read-key",
        "API_URL": "http://backend:8000/api",
        "BACKEND_INTERNAL_URL": "http://backend:8000",
        "MEDIA_ORIGINS": "",
        "PREVIEW_SECRET": "test-preview-secret",
        "REVALIDATE_SECRET": "test-revalidate-secret",
        "SITE_URL": "https://example.com"
      },
      "image": "site-frontend",
      "networks": {
        "default": {
          "aliases": [
            "frontend"
          ]
        }
      },
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "build": {
        "context": "/project/frontend",
        "dockerfile": "Dockerfile",
        "target": "prod"
      },
      "depends_on": {
        "backend-prod": {
          "condition": "service_healthy",
          "required": true
        }
      }
    },
    "proxy": {
      "profiles": [
        "prod"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "memory": "268435456"
          }
        },
        "placement": {}
      },
      "restart": "unless-stopped",
      "cap_add": [
        "NET_BIND_SERVICE"
      ],
      "cap_drop": [
        "ALL"
      ],
      "command": null,
      "entrypoint": null,
      "environment": {
        "CADDY_ADDRESS": ":80",
        "TRUSTED_PROXIES": "203.0.113.1 203.0.113.2"
      },
      "image": "caddy:2.11-alpine",
      "networks": {
        "default": null
      },
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/project/Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "media",
          "target": "/srv/media",
          "read_only": true,
          "volume": {}
        },
        {
          "type": "volume",
          "source": "caddy_data",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "caddy_config",
          "target": "/config",
          "volume": {}
        }
      ],
      "depends_on": {
        "backend-prod": {
          "condition": "service_healthy",
          "required": true
        },
        "frontend-prod": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "80",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "udp"
        }
      ]
    },
    "worker-prod": {
      "profiles": [
        "prod"
      ],
      "deploy": {
        "resources": {
          "limits": {
            "memory": "536870912"
          }
        },
        "placement": {}
      },
      "restart": "unless-stopped",
      "cap_drop": [
        "ALL"
      ],
      "command": [
        "python",
        "manage.py",
        "run_huey"
      ],
      "entrypoint": null,
      "environment": {
        "ADMIN_EMAIL": "admin@example.com",
        "ADMIN_PASSWORD": "test-admin-password",
        "ADMIN_USERNAME": "admin",
        "API_READ_KEY": "test-api-read-key",
        "API_SECRET_KEY": "test-api-secret-key",
        "BACKEND_URL": "https://example.com",
        "BACKUP_DAILY": "1",
        "BACKUP_DIR": "/app/backups",
        "BACKUP_KEEP": "14",
        "BACKUP_MEDIA": "1",
        "BACKUP_S3_BUCKET": "",
        "BACKUP_TIME": "03:00",
        "CACHE_URL": "redis://cache:6379/0",
        "COMPOSE_PROFILES": "prod,db",
        "DATABASE_URL": "postgres://app:test-postgres-password@db:5432/app",
        "DEFAULT_FROM_EMAIL": "site <noreply@example.com>",
        "DJANGO_DEBUG": "0",
        "DJANGO_SECRET_KEY": "test-django-secret-key",
        "EMAIL_URL": "smtp+tls://user:password@smtp.example.com:587",
        "NUM_PROXIES": "2",
        "POSTGRES_DB": "app",
        "POSTGRES_PASSWORD": "test-postgres-password",
        "POSTGRES_USER": "app",
        "PREVIEW_SECRET": "test-preview-secret",
        "PROJECT_NAME": "site",
        "REVALIDATE_SECRET": "test-revalidate-secret",
        "REVALIDATE_URL": "http://frontend:3000/revalidate",
        "S3_ACCESS_KEY_ID": "",
        "S3_BUCKET": "site-media",
        "S3_ENDPOINT_URL": "",
        "S3_PUBLIC_URL": "",
        "S3_REGION": "",
        "S3_SECRET_ACCESS_KEY": "",
        "SEED_DEMO_CONTENT": "1",
        "SITE_URL": "https://example.com"
      },
      "image": "site-backend",
      "networks": {
        "default": null
      },
      "read_only": true,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp"
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "media",
          "target": "/app/media",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "backups",
          "target": "/app/backups",
          "volume": {}
        }
      ],
      "build": {
        "context": "/project/backend",
        "dockerfile": "Dockerfile",
        "target": "prod"
      },
      "depends_on": {
        "backend-prod": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "healthcheck": {
        "disable": true
      }
    }
  },
  "volumes": {
    "backups": {
      "name": "site_backups"
    },
    "caddy_config": {
      "name": "site_caddy_config"
    },
    "caddy_data": {
      "name": "site_caddy_data"
    },
    "media": {
      "name": "site_media"
    },
    "pgdata": {
      "name": "site_pgdata"
    }
  }
}
