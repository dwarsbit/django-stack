{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.astro",
      "!**/.docusaurus",
      "!website/build",
      "!examples",
      "!templates/**/*.astro",
      "!templates/**/*.yaml",
      "!templates/frontend-astro/src/lib/headless.ts",
      "!.github/**/*.yml",
      "!**/*.json",
      "!**/*.md",
      "!**/*.mdx",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
